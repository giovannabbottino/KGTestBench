# Copy this file to .env and adjust the values for your environment.

KG_LANGUAGE=en
KG_WIKIDATA_URL=https://www.wikidata.org/w/api.php
KG_WIKIPEDIA_URL=https://{language}.wikipedia.org/w/api.php
KG_CANDIDATE_LIMIT=2
KG_SEARCH_CANDIDATE_LIMIT=10
KG_PHRASE_LIMIT=2
KG_REQUEST_TIMEOUT=15
KG_REQUEST_INTERVAL=1
KG_RETRY_STATUSES=429,500,502,503,504
KG_USER_AGENT=KGTestBench/0.1 (source collection; contact: you@example.org)
